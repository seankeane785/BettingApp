{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://formfirst.local/schemas/saved-analysis-run.v1.schema.json", "title": "SavedAnalysisRun v1", "description": "Local export contract for a deterministic analysis run.",
  "type": "object", "additionalProperties": false, "required": ["packName", "schemaVersion", "runId", "createdAt", "dataStatus", "fixturePackRef", "researchPackRef", "modelVersion", "settings", "validation", "candidates", "builders", "results"],
  "properties": {
    "packName": {"const": "SavedAnalysisRun v1"}, "schemaVersion": {"const": "1.0.0"}, "runId": {"type": "string", "minLength": 1}, "createdAt": {"type": "string", "format": "date-time"}, "dataStatus": {"enum": ["synthetic", "real"]},
    "fixturePackRef": {"$ref": "#/$defs/packRef"}, "researchPackRef": {"$ref": "#/$defs/packRef"}, "modelVersion": {"type": "string", "minLength": 1},
    "settings": {"type": "object", "additionalProperties": false, "required": ["deterministic", "referenceTimestamp", "maximumSourceAgeHours"], "properties": {"deterministic": {"const": true}, "referenceTimestamp": {"type": "string", "format": "date-time"}, "maximumSourceAgeHours": {"type": "integer", "minimum": 1}}},
    "validation": {"type": "object", "additionalProperties": false, "required": ["valid", "errors", "warnings"], "properties": {"valid": {"type": "boolean"}, "errors": {"type": "array", "items": {"type": "string"}}, "warnings": {"type": "array", "items": {"type": "string"}}}},
    "candidates": {"type": "array", "items": {"$ref": "#/$defs/generated"}}, "builders": {"type": "array", "items": {"$ref": "#/$defs/generated"}},
    "results": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["itemId", "outcome", "note"], "properties": {"itemId": {"type": "string", "minLength": 1}, "outcome": {"enum": ["pending", "won", "lost", "void"]}, "note": {"type": ["string", "null"]}}}}
  },
  "$defs": {"packRef": {"type": "object", "additionalProperties": false, "required": ["packName", "schemaVersion", "fixtureDate"], "properties": {"packName": {"type": "string", "minLength": 1}, "schemaVersion": {"const": "1.0.0"}, "fixtureDate": {"type": "string", "format": "date"}}}, "generated": {"type": "object", "additionalProperties": false, "required": ["itemId", "fixtureIds", "description", "reasonsFor", "reasonsAgainst", "dataQuality"], "properties": {"itemId": {"type": "string", "minLength": 1}, "fixtureIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "description": {"type": "string"}, "reasonsFor": {"type": "array", "items": {"type": "string"}}, "reasonsAgainst": {"type": "array", "items": {"type": "string"}}, "dataQuality": {"enum": ["complete", "partial", "insufficient"]}}}}
}
